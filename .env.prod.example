# ─── Avion production config ───────────────────────────────────────────────
# Copy this to ".env" on the droplet and fill in the values, then run:
#   docker compose -f docker-compose.prod.yml up -d --build
# (.env is git-ignored — never commit real secrets.)

# App encryption key. Generate one with:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGE_ME

# Your droplet's public IP, e.g. http://203.0.113.10  (no trailing slash, port 80)
APP_URL=http://YOUR_DROPLET_IP

# Strong Postgres password (used by both Postgres and the app).
DB_PASSWORD=change_this_to_a_strong_password

# Seed demo data on first boot: true = populated demo (airports, flights, users);
# false = empty database. Seeding is guarded, so it won't repeat on restarts.
DB_SEED=true

# Path to the cloned frontend repo, relative to this backend repo.
# Default assumes it's a sibling folder named "AirlineSystemFront-End".
FRONTEND_CONTEXT=../AirlineSystemFront-End

# ─── Email (for password-reset messages) ───────────────────────────────────
# Easiest with a Gmail account + an "App Password" (Google account → Security →
# 2-Step Verification → App passwords). Port 587 works from a droplet (25 is blocked).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password   # the App Password, NOT your login password
MAIL_FROM_ADDRESS=your_email@gmail.com
#
# Alternatives (same fields, different host):
#   Brevo:    MAIL_HOST=smtp-relay.brevo.com   MAIL_PORT=587
#   SendGrid: MAIL_HOST=smtp.sendgrid.net       MAIL_PORT=587  MAIL_USERNAME=apikey
#   Mailgun:  MAIL_HOST=smtp.mailgun.org        MAIL_PORT=587
