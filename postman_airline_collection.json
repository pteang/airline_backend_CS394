{
  "info": {
    "_postman_id": "d74f30ca-6ac7-4d9a-9918-airline-api",
    "name": "Airline API",
    "description": "Converted from insomnia_airline_collection.json. Run Auth > Login first; its test script automatically saves the returned bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {"key": "token", "value": "{{token}}", "type": "string"}
    ]
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string"},
    {"key": "token", "value": "", "type": "string"},
    {"key": "flight_id", "value": "1", "type": "string"},
    {"key": "booking_id", "value": "1", "type": "string"},
    {"key": "aircraft_id", "value": "1", "type": "string"}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Passenger\",\n  \"email\": \"new@example.test\",\n  \"password\": \"password\",\n  \"phone\": \"+1-555-0199\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login (passenger or staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.test\",\n  \"password\": \"password\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password\",\n  \"new_password\": \"newpass123\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Flights (public)",
      "item": [
        {
          "name": "Search Flights",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/flights/search?origin=New%20York%20(JFK)&destination=Los%20Angeles%20(LAX)&class=business&date=",
              "host": ["{{base_url}}"],
              "path": ["flights", "search"],
              "query": [
                {"key": "origin", "value": "New York (JFK)"},
                {"key": "destination", "value": "Los Angeles (LAX)"},
                {"key": "class", "value": "business"},
                {"key": "date", "value": ""}
              ]
            }
          }
        },
        {
          "name": "List Flights",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/flights"
          }
        },
        {
          "name": "Get Flight",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/flights/{{flight_id}}"
          }
        },
        {
          "name": "Flight Seats",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/flights/{{flight_id}}/seats"
          }
        }
      ]
    },
    {
      "name": "Bookings (passenger)",
      "item": [
        {
          "name": "My Bookings",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/bookings"
          }
        },
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('booking_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight_id\": {{flight_id}},\n  \"passengers\": [\n    {\n      \"passenger_id\": 1,\n      \"seat_class\": \"business\",\n      \"flight_seat_id\": 5\n    }\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/bookings"
          }
        },
        {
          "name": "Get Booking",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/bookings/{{booking_id}}"
          }
        },
        {
          "name": "Pay Booking",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"credit_card\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/bookings/{{booking_id}}/payment"
          }
        },
        {
          "name": "Booking Ticket",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/bookings/{{booking_id}}/ticket"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/bookings/{{booking_id}}/cancel"
          }
        }
      ]
    },
