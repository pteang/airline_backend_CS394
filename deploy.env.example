# Copy to `deploy.env` and fill in your droplet details, then run ./deploy.sh
# deploy.env is gitignored — it stays on your machine only.

# Public IP (or hostname) of your DigitalOcean droplet.
DROPLET_HOST=206.189.84.21

# SSH user on the droplet (DigitalOcean's default image uses root).
DROPLET_USER=root

# Where the two repos live on the droplet (siblings, per DEPLOY.md).
REMOTE_DIR=/root/avion

# Local path to the frontend repo, relative to this backend repo.
# This is the user's confirmed working copy (2026-07-28).
FRONTEND_DIR=../Documents/Multi-role web app design
